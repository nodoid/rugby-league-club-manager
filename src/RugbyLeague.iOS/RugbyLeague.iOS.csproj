<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
    <ApplicationId>uk.co.allthejohnsons.rugbyleaguegame</ApplicationId>
    <ApplicationTitle>Rugby League Club Manager</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- Tells actool to compile AppIcon.appiconset into Assets.car; without it the icon is dropped. -->
    <AppIcon>AppIcon</AppIcon>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <MtouchLink>SdkOnly</MtouchLink>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.iOS" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RugbyLeague.Game\RugbyLeague.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="..\RugbyLeague.Game\Content\Content.mgcb" />
  </ItemGroup>

  <!--
    Signing identities are personal to whoever is building, so they are not committed. Copy
    LocalSigning.props.example to LocalSigning.props in the repository root and fill in your own
    Certificate (CodesignKey) and provisioning profile (CodesignProvision).
  -->
  <Import Project="..\..\LocalSigning.props" Condition="Exists('..\..\LocalSigning.props')" />

</Project>
